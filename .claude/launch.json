{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kids-buddy",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "dashboard"],
      "port": 4242,
      "autoPort": true
    },
    {
      "name": "react-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "react-app", "run", "dev"],
      "port": 7100,
      "url": "http://localhost:7100"
    },
    {
      "name": "landing",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "landing", "-l", "7000"],
      "port": 7000
    }
  ]
}
